# ===== Serveur (Vercel > Settings > Environment Variables) — AUCUNE de ces variables n'est exposée au navigateur =====
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="clé service_role (Supabase > Project Settings > API)"
TEACHER_PASSWORD="mot de passe de connexion enseignant"
AUTH_SECRET="chaîne aléatoire d'au moins 32 caractères (ex: openssl rand -hex 32)"
GEMINI_API_KEY="optionnel : génération de questions par IA"

# ===== Front-end (public) =====
# Segment secret du lien enseignant : https://votre-site/#/<valeur>
VITE_TEACHER_ROUTE="enseignant"
